{
  "yonomi-word": {
    "desc": "Reference style: 1-2 word chunks, white Inter ExtraBold, no outline, soft shadow, blur-in, on the chest",
    "font": "inter-extrabold",
    "size": 100,
    "color": "#FFFFFF",
    "highlight": "#FFFFFF",
    "outline": "#000000",
    "outline_w": 0,
    "shadow": 4,
    "anim": "blur",
