    "max_words": 2,
    "position": 0.5,
    "brand_highlight": false,
    "line_height": 0.86
  },
  "yonomi-stack": {
    "desc": "Reference hook style: 3 words stacked on tight leading, white, blur-rise",
    "font": "inter-extrabold",
    "size": 104,
    "color": "#FFFFFF",
    "highlight": "#FFFFFF",
    "outline": "#000000",
    "outline_w": 0,
    "shadow": 4,
    "anim": "stack",
    "uppercase": false,
    "max_words": 3,
