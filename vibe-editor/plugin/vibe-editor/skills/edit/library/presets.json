{
  "hook-slam": {"desc": "Opening hook: punch zoom + slamming title + flash + impact.", "params": {"text": "WATCH THIS"},
    "events": [{"type": "zoom", "at": 0, "dur": 1.0, "style": "punch", "amount": 1.3},
               {"type": "title", "at": 0, "dur": 2.0, "text": "{text}", "style": "punch", "position": "top", "sfx": "impact"},
               {"type": "flash", "at": 0.05, "dur": 0.25}]},
  "breaking-news": {"desc": "Breaking-news style banner with a red label.", "params": {"text": "BIG NEWS"},
    "events": [{"type": "tag", "at": 0, "dur": 2.6, "text": "BREAKING", "fill": "#E5322D", "color": "#FFFFFF", "position": 0.18, "sfx": "alarm"},
               {"type": "title", "at": 0.15, "dur": 2.4, "text": "{text}", "style": "highlight", "position": 0.28},
               {"type": "flash", "at": 0, "dur": 0.2}]},
  "money-moment": {"desc": "Money count-up with confetti and a cash sound.", "params": {"from": 0, "to": 100000, "prefix": "₹", "label": "earned"},
    "events": [{"type": "counter", "at": 0, "dur": 2.6, "from": "{from}", "to": "{to}", "prefix": "{prefix}", "label": "{label}"},
               {"type": "confetti", "at": 1.6, "dur": 1.6}]},
  "mind-blown": {"desc": "Manga impact frame + shockwave + shake.", "params": {"text": "MIND BLOWN"},
    "events": [{"type": "impact", "at": 0, "dur": 0.9, "text": "{text}"},
               {"type": "shockwave", "at": 0.05, "dur": 0.8}]},
  "plot-twist": {"desc": "Focus pull + glitch title.", "params": {"text": "PLOT TWIST"},
    "events": [{"type": "rack_focus", "at": 0, "dur": 0.7},
               {"type": "glitch", "at": 0, "dur": 0.3},
               {"type": "title", "at": 0.1, "dur": 2.0, "text": "{text}", "style": "glitch", "position": "upper"}]},
  "the-secret": {"desc": "Spotlight on you + elegant serif reveal.", "params": {"text": "the secret?"},
    "events": [{"type": "spotlight", "at": 0, "dur": 2.4},
               {"type": "title", "at": 0.2, "dur": 2.2, "text": "{text}", "style": "serif", "size": "xl", "position": "upper", "sfx": "reverse-whoosh"}]},
  "hot-take": {"desc": "Rotated stamp + comic burst + shake.", "params": {"text": "HOT TAKE"},
    "events": [{"type": "burst", "at": 0, "dur": 1.6, "text": "{text}"},
               {"type": "shake", "at": 0, "dur": 0.35}]},
  "wrong": {"desc": "Black & white + red WRONG stamp + buzzer.", "params": {"text": "WRONG"},
    "events": [{"type": "bw", "at": 0, "dur": 1.4},
               {"type": "stamp", "at": 0, "dur": 1.4, "text": "{text}", "color": "#FF3B30", "sfx": "error"}]},
  "correct": {"desc": "Green CORRECT stamp + sparkles + success jingle.", "params": {"text": "CORRECT"},
    "events": [{"type": "stamp", "at": 0, "dur": 1.6, "text": "{text}", "color": "#34C759", "sfx": "success"},
               {"type": "sparkles", "at": 0.1, "dur": 1.4}]},
  "big-reveal": {"desc": "Darken + drum roll, then a flash and title on the reveal.", "params": {"text": "THE ANSWER"},
    "events": [{"type": "darken", "at": 0, "dur": 1.2, "amount": 0.3},
               {"type": "sfx", "at": 0, "name": "drum-roll", "volume": 0.5},
               {"type": "flash", "at": 1.2, "dur": 0.3},
               {"type": "title", "at": 1.2, "dur": 2.0, "text": "{text}", "style": "punch", "position": "upper", "sfx": "bass-drop"}]},
  "quick-tip": {"desc": "Tip card with a doodle star.", "params": {"text": "Your tip here", "label": "TIP"},
    "events": [{"type": "card", "at": 0, "dur": 3.0, "style": "tip", "label": "{label}", "text": "{text}", "position": "lower"},
               {"type": "doodle", "at": 0.2, "dur": 2.6, "shape": "star", "x": 0.84, "y": 0.52, "size": 90}]},
  "pov": {"desc": "POV title that types on, with cinematic bars.", "params": {"text": "you finally edit like a pro"},
    "events": [{"type": "letterbox", "at": 0, "dur": 3.0},
               {"type": "title", "at": 0, "dur": 3.0, "text": "POV: {text}", "style": "typewriter", "position": "top", "size": "m", "uppercase": false}]},
  "before-after": {"desc": "BEFORE (black & white) then AFTER (colour) with a flash.", "params": {"split": 1.5},
    "events": [{"type": "bw", "at": 0, "dur": "{split}"},
               {"type": "tag", "at": 0, "dur": "{split}", "text": "BEFORE", "position": "upper"},
               {"type": "flash", "at": "{split}", "dur": 0.25},
               {"type": "tag", "at": "{split}", "dur": 1.6, "text": "AFTER", "position": "upper", "fill": "accent"}]},
  "warning": {"desc": "Red warning label + dim + alarm.", "params": {"text": "DON'T DO THIS"},
    "events": [{"type": "darken", "at": 0, "dur": 2.0, "amount": 0.2},
               {"type": "tag", "at": 0, "dur": 2.2, "text": "WARNING", "fill": "#E5322D", "color": "#FFFFFF", "position": 0.17, "sfx": "alarm"},
               {"type": "title", "at": 0.15, "dur": 2.0, "text": "{text}", "style": "punch", "position": 0.27}]},
  "game-changer": {"desc": "Two-tone stacked title with sparkles and a magic chime.", "params": {"text": "game *changer*"},
    "events": [{"type": "title", "at": 0, "dur": 2.4, "text": "{text}", "style": "stack", "position": "upper", "sfx": "magic"},
               {"type": "sparkles", "at": 0.2, "dur": 2.0}]},
  "comment-keyword": {"desc": "Comment box typing your keyword + CTA (for lead magnets).", "params": {"keyword": "GUIDE"},
    "events": [{"type": "comment", "at": 0, "dur": 3.0, "text": "{keyword}"},
               {"type": "cta", "at": 0.6, "dur": 2.4, "text": "Comment *{keyword}*", "position": "lower"}]},
  "follow-cta": {"desc": "Follow CTA with a hand-drawn arrow and heart pop.", "params": {"text": "Follow for more"},
    "events": [{"type": "cta", "at": 0, "dur": 2.8, "text": "{text}", "sfx": "heart-pop"},
               {"type": "doodle", "at": 0.3, "dur": 2.4, "shape": "arrow", "x": 0.80, "y": 0.55, "size": 120, "rotate": 120}]},
  "save-this": {"desc": "SAVE THIS label with a doodle star.", "params": {"text": "SAVE THIS"},
    "events": [{"type": "word_sticker", "at": 0, "dur": 2.2, "text": "{text}"},
               {"type": "doodle", "at": 0.2, "dur": 2.0, "shape": "sparkle", "x": 0.18, "y": 0.2, "size": 80}]},
  "cover-story": {"desc": "Huge magazine word behind you (AI cut-out).", "params": {"text": "EDIT"},
    "events": [{"type": "title", "at": 0, "dur": 2.4, "text": "{text}", "style": "fade", "font": "dm-serif", "size": 420, "position": 0.24, "behind": true, "sfx": "whoosh"}]},
  "freeze-label": {"desc": "Freeze frame with a stamped label and camera flash.", "params": {"text": "THIS MOMENT"},
    "events": [{"type": "freeze", "at": 0, "dur": 1.3, "text": "{text}", "sfx": "camera-flash"}]},
  "manga": {"desc": "Manga impact frame with speed lines.", "params": {"text": "BOOM"},
    "events": [{"type": "impact", "at": 0, "dur": 1.0, "text": "{text}"},
               {"type": "speed_lines", "at": 0, "dur": 1.0, "color": "#000000"}]},
  "newspaper": {"desc": "You on the front page of a newspaper.", "params": {"text": "Breaking: you did it", "sub": "Everyone is talking about it"},
    "events": [{"type": "frame", "style": "newspaper", "at": 0, "dur": 2.6, "text": "{text}", "sub": "{sub}"}]},
  "money-note": {"desc": "You printed on a banknote with a big number.", "params": {"number": "1,00,000", "sub": "first month"},
    "events": [{"type": "frame", "style": "banknote", "at": 0, "dur": 2.6, "number": "{number}", "sub": "{sub}", "sfx": "cash"}]},
  "sticker-me": {"desc": "Freeze into a sticker cut-out with a word sticker.", "params": {"text": "ME"},
    "events": [{"type": "cutout", "at": 0, "dur": 1.6},
               {"type": "word_sticker", "at": 0.15, "dur": 1.4, "text": "{text}", "x": 0.72, "y": 0.2}]},
  "clone-army": {"desc": "Copies of you fan out behind you.", "params": {"count": 4},
    "events": [{"type": "clone", "at": 0, "dur": 1.8, "count": "{count}"}]},
  "type-wall": {"desc": "Huge scrolling text rows behind you (AI cut-out).", "params": {"text": "EVERYBODY'S TALKING"},
    "events": [{"type": "typewall", "at": 0, "dur": 2.5, "text": "{text}", "behind": true}]}
}
